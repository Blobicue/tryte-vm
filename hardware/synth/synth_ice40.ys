# Yosys synthesis script for Lattice iCE40 FPGA
read_verilog -sv hardware/rtl/tryte_pkg.sv
read_verilog -sv hardware/rtl/tryte_alu.sv
read_verilog -sv hardware/rtl/tryte_cpu.sv
read_verilog -sv hardware/rtl/tryte_ram.sv
read_verilog -sv hardware/rtl/tryte_top.sv

hierarchy -check -top tryte_top
synth_ice40 -top tryte_top
stat
check -noinit
