; programs/secure_microkernel.tasm — Native Tryte-QOS Secure Microkernel with IPC
;
; Implements:
;   - Multi-tasking cooperative round-robin scheduler
;   - Kernel IPC Mailbox: Protected message buffer between processes
;   - Syscalls:
;       arg =  0 : SYS_YIELD (yield CPU)
;       arg =  1 : SYS_OUT   (emit value to OUT queue)
;       arg =  2 : SYS_SEND  (write payload to IPC mailbox, flag PENDING)
;       arg =  3 : SYS_RECV  (read payload from IPC mailbox, flag EMPTY)
;       arg = -1 : SYS_EXIT  (terminate calling task)
;   - User Processes:
;       Process 1 (Alice / Secure Sender): Encrypts trits with session key, invokes SYS_SEND
;       Process 2 (Bob / Secure Receiver): Invokes SYS_RECV, decrypts trits, emits to OUT

; --- Microkernel Entry Point ---
kernel_boot:
        LOADI 1
        STORE p1_status         ; Process 1 = READY (1)
        LOADI 1
        STORE p2_status         ; Process 2 = READY (1)

        LOADI 0
        STORE mbox_status       ; Mailbox = EMPTY (0)
        STORE active_pid        ; Start with Process 1 (0)

scheduler_loop:
        ; Check if Process 1 is ready
        LOAD  p1_status
        BR3   chk_p1
chk_p1: .table chk_p2_only, chk_p2_only, run_p1

chk_p2_only:
        ; Process 1 not ready; check Process 2
        LOAD  p2_status
        BR3   chk_p2
chk_p2: .table all_done, all_done, run_p2

run_p1:
        LOADI 0
        STORE active_pid
        LDC   p1_reg_c
        JMPX  p1_pc

run_p2:
        LOADI 1
        STORE active_pid
        LDC   p2_reg_c
        JMPX  p2_pc

; --- System Call Dispatcher ---
syscall_trap:
        STORE sys_arg
        LOAD  active_pid
        BR3   route_pid
route_pid: .table handle_p1_call, handle_p1_call, handle_p2_call

; ===========================================================================
; Process 1 Syscall Handler
; ===========================================================================
handle_p1_call:
        LOAD  sys_arg
        BR3   chk_p1_arg
chk_p1_arg: .table chk_p1_neg, sys_yield_p1, chk_p1_pos

chk_p1_pos:
        LOAD  sys_arg
        ADDI  -1
        BR3   chk_p1_is_one
chk_p1_is_one: .table sys_bad_p1, sys_out_p1, chk_p1_is_two_or_three

chk_p1_is_two_or_three:
        LOAD  sys_arg
        ADDI  -2
        BR3   chk_p1_is_two
chk_p1_is_two: .table sys_bad_p1, sys_send_p1, chk_p1_is_three

chk_p1_is_three:
        LOAD  sys_arg
        ADDI  -3
        BR3   chk_p1_is_three_br
chk_p1_is_three_br: .table sys_bad_p1, sys_recv_p1, sys_bad_p1

chk_p1_neg:
        LOAD  sys_arg
        ADDI  1
        BR3   chk_p1_is_neg_one
chk_p1_is_neg_one: .table sys_bad_p1, sys_exit_p1, sys_bad_p1

sys_bad_p1:
        LOADI -364              ; Fault code: Process 1 crashed
        STORE p1_status
        JMP   chk_p2_only

sys_exit_p1:
        LOADI -1
        STORE p1_status
        JMP   chk_p2_only

sys_yield_p1:
        LOAD  p2_status
        BR3   chk_p2_after_y1
chk_p2_after_y1: .table run_p1, run_p1, run_p2

sys_out_p1:
        LOAD  p1_val
        OUT
        LOAD  p2_status
        BR3   chk_p2_after_o1
chk_p2_after_o1: .table run_p1, run_p1, run_p2

; SYS_SEND from Process 1: copy p1_buf -> mbox_data, set mbox_status = 1
sys_send_p1:
        LOAD  p1_buf_0
        STORE mbox_data_0
        LOAD  p1_buf_1
        STORE mbox_data_1
        LOAD  p1_buf_2
        STORE mbox_data_2
        LOAD  p1_buf_tag
        STORE mbox_data_tag
        LOADI 1
        STORE mbox_status       ; MBOX_PENDING (1)
        ; Yield to Process 2 so it can receive
        LOAD  p2_status
        BR3   chk_p2_after_s1
chk_p2_after_s1: .table run_p1, run_p1, run_p2

; SYS_RECV for Process 1 (unused by sender)
sys_recv_p1:
        LOADI 0
        JMP   sys_yield_p1

; ===========================================================================
; Process 2 Syscall Handler
; ===========================================================================
handle_p2_call:
        LOAD  sys_arg
        BR3   chk_p2_arg
chk_p2_arg: .table chk_p2_neg, sys_yield_p2, chk_p2_pos

chk_p2_pos:
        LOAD  sys_arg
        ADDI  -1
        BR3   chk_p2_is_one
chk_p2_is_one: .table sys_bad_p2, sys_out_p2, chk_p2_is_two_or_three

chk_p2_is_two_or_three:
        LOAD  sys_arg
        ADDI  -2
        BR3   chk_p2_is_two
chk_p2_is_two: .table sys_bad_p2, sys_send_p2, chk_p2_is_three

chk_p2_is_three:
        LOAD  sys_arg
        ADDI  -3
        BR3   chk_p2_is_three_br
chk_p2_is_three_br: .table sys_bad_p2, sys_recv_p2, sys_bad_p2

chk_p2_neg:
        LOAD  sys_arg
        ADDI  1
        BR3   chk_p2_is_neg_one
chk_p2_is_neg_one: .table sys_bad_p2, sys_exit_p2, sys_bad_p2

sys_bad_p2:
        LOADI -364              ; Fault code: Process 2 crashed
        STORE p2_status
        JMP   scheduler_loop

sys_exit_p2:
        LOADI -1
        STORE p2_status
        JMP   scheduler_loop

sys_yield_p2:
        LOAD  p1_status
        BR3   chk_p1_after_y2
chk_p1_after_y2: .table run_p2, run_p2, run_p1

sys_out_p2:
        LOAD  p2_val
        OUT
        LOAD  p1_status
        BR3   chk_p1_after_o2
chk_p1_after_o2: .table run_p2, run_p2, run_p1

sys_send_p2:
        LOADI 0
        JMP   sys_yield_p2

; SYS_RECV for Process 2: if mbox_status == 1, copy to p2_buf, set mbox_status = 0
sys_recv_p2:
        LOAD  mbox_status
        BR3   chk_mbox_p2
chk_mbox_p2: .table mbox_empty_p2, mbox_empty_p2, mbox_ready_p2

mbox_ready_p2:
        LOAD  mbox_data_0
        STORE p2_buf_0
        LOAD  mbox_data_1
        STORE p2_buf_1
        LOAD  mbox_data_2
        STORE p2_buf_2
        LOAD  mbox_data_tag
        STORE p2_buf_tag
        LOADI 0
        STORE mbox_status       ; MBOX_EMPTY (0)
        ; Resume Process 2 with A = 1 (data received)
        LOADI 1
        STORE p2_recv_res
        JMP   run_p2

mbox_empty_p2:
        ; Mailbox empty; yield back to Process 1 to let it send
        LOADI 0
        STORE p2_recv_res
        LOAD  p1_status
        BR3   chk_p1_after_empty2
chk_p1_after_empty2: .table run_p2, run_p2, run_p1

all_done:
        LOADI 0                 ; Clean shutdown
        HALT

; ===========================================================================
; User Process 1: Secure Sender (Alice)
; Encrypts message (m0, m1, m2) with session key (k0, k1, k2) mod 3:
;   c_i = (m_i + k_i) mod 3
; Sends ciphertext + tag across kernel mailbox via SYS_SEND (arg = 2).
; ===========================================================================
p1_body:
        ; Encrypt trit 0: c0 = (m0 + k0) mod 3
        LOAD  p1_msg_0
        ADD   p1_key_0
        STORE p1_tmp
        ; Reduce mod 3
        LOAD  p1_tmp
        SHR   1
        SHL   1
        STORE p1_sub
        LOAD  p1_tmp
        SUB   p1_sub
        STORE p1_buf_0

        ; Encrypt trit 1: c1 = (m1 + k1) mod 3
        LOAD  p1_msg_1
        ADD   p1_key_1
        STORE p1_tmp
        LOAD  p1_tmp
        SHR   1
        SHL   1
        STORE p1_sub
        LOAD  p1_tmp
        SUB   p1_sub
        STORE p1_buf_1

        ; Encrypt trit 2: c2 = (m2 + k2) mod 3
        LOAD  p1_msg_2
        ADD   p1_key_2
        STORE p1_tmp
        LOAD  p1_tmp
        SHR   1
        SHL   1
        STORE p1_sub
        LOAD  p1_tmp
        SUB   p1_sub
        STORE p1_buf_2

        ; MAC tag: simple balanced sum of ciphertexts (c0 + c1 + c2) mod 3
        LOAD  p1_buf_0
        ADD   p1_buf_1
        ADD   p1_buf_2
        STORE p1_tmp
        LOAD  p1_tmp
        SHR   1
        SHL   1
        STORE p1_sub
        LOAD  p1_tmp
        SUB   p1_sub
        STORE p1_buf_tag

        ; Setup return PC after SYS_SEND
        LOADI p1_finish
        STORE p1_pc

        ; Call SYS_SEND (arg = 2)
        LOADI 2
        JMP   syscall_trap

p1_finish:
        ; Terminate Process 1 via SYS_EXIT (arg = -1)
        LOADI -1
        JMP   syscall_trap

; ===========================================================================
; User Process 2: Secure Receiver (Bob)
; Invokes SYS_RECV (arg = 3) to fetch ciphertext from mailbox.
; Verifies tag, decrypts trits:
;   m_i = (c_i - k_i) mod 3
; Emits decrypted message to OUT.
; ===========================================================================
p2_body:
        LOADI p2_after_recv
        STORE p2_pc
        ; Call SYS_RECV (arg = 3)
        LOADI 3
        JMP   syscall_trap

p2_after_recv:
        ; Check if data was received (p2_recv_res == 1)
        LOAD  p2_recv_res
        BR3   p2_chk_res
p2_chk_res: .table p2_body, p2_body, p2_process_data

p2_process_data:
        ; Decrypt trit 0: m0 = (c0 - k0) mod 3
        LOAD  p2_buf_0
        SUB   p2_key_0
        STORE p2_tmp
        LOAD  p2_tmp
        SHR   1
        SHL   1
        STORE p2_sub
        LOAD  p2_tmp
        SUB   p2_sub
        STORE p2_val
        LOADI p2_step_m1
        STORE p2_pc
        LOADI 1                 ; SYS_OUT trit 0
        JMP   syscall_trap

p2_step_m1:
        ; Decrypt trit 1: m1 = (c1 - k1) mod 3
        LOAD  p2_buf_1
        SUB   p2_key_1
        STORE p2_tmp
        LOAD  p2_tmp
        SHR   1
        SHL   1
        STORE p2_sub
        LOAD  p2_tmp
        SUB   p2_sub
        STORE p2_val
        LOADI p2_step_m2
        STORE p2_pc
        LOADI 1                 ; SYS_OUT trit 1
        JMP   syscall_trap

p2_step_m2:
        ; Decrypt trit 2: m2 = (c2 - k2) mod 3
        LOAD  p2_buf_2
        SUB   p2_key_2
        STORE p2_tmp
        LOAD  p2_tmp
        SHR   1
        SHL   1
        STORE p2_sub
        LOAD  p2_tmp
        SUB   p2_sub
        STORE p2_val
        LOADI p2_terminate
        STORE p2_pc
        LOADI 1                 ; SYS_OUT trit 2
        JMP   syscall_trap

p2_terminate:
        ; Terminate Process 2 via SYS_EXIT (arg = -1)
        LOADI -1
        JMP   syscall_trap

; ===========================================================================
; Data Section & Task Control Blocks
; ===========================================================================
active_pid:   .word 0
sys_arg:      .word 0

; Kernel IPC Mailbox
mbox_status:   .word 0          ; 0 = EMPTY, 1 = PENDING
mbox_data_0:   .word 0
mbox_data_1:   .word 0
mbox_data_2:   .word 0
mbox_data_tag: .word 0

; Process 1 Control Block & Buffers
p1_status:    .word 1
p1_val:       .word 0
p1_reg_c:     .word 0
p1_pc:        .word p1_body
p1_msg_0:     .word 1           ; Message: [1, -1, 1]
p1_msg_1:     .word -1
p1_msg_2:     .word 1
p1_key_0:     .word -1          ; Session Key: [-1, 1, 0]
p1_key_1:     .word 1
p1_key_2:     .word 0
p1_buf_0:     .word 0
p1_buf_1:     .word 0
p1_buf_2:     .word 0
p1_buf_tag:   .word 0
p1_tmp:       .word 0
p1_sub:       .word 0

; Process 2 Control Block & Buffers
p2_status:    .word 1
p2_val:       .word 0
p2_reg_c:     .word 0
p2_pc:        .word p2_body
p2_recv_res:  .word 0
p2_key_0:     .word -1          ; Matching Session Key: [-1, 1, 0]
p2_key_1:     .word 1
p2_key_2:     .word 0
p2_buf_0:     .word 0
p2_buf_1:     .word 0
p2_buf_2:     .word 0
p2_buf_tag:   .word 0
p2_tmp:       .word 0
p2_sub:       .word 0
