; interp.tasm — a tryte VM, running inside a tryte VM.
;
; The emulated ("inner") machine has the same three registers, the same 23
; opcodes and the same two-cell instruction format. It differs only in having
; less memory, which is unavoidable: 729 cells cannot hold 729 cells plus an
; interpreter.
;
; RELOCATABLE. There is deliberately no .org here and IBASE is rewritten at load
; time, because a fixed layout can never nest. With one fixed base the emulated
; machine's address window never reaches back down to the interpreter's own
; origin, so no copy of this file could ever be loaded into a machine it was
; running — see src/selfhost.js, which computes an origin and a base per level.
;
; DECODE. The effective address of the operand (ea) and the value living there
; (mval) are computed once during fetch rather than in each handler. That is
; what makes the interpreter small enough to nest: it moved roughly ninety cells
; of repeated address arithmetic out of twelve handlers and into one place. The
; same pressure produced instruction decode in real machines, for the same reason.
;
; A consequence worth stating: opcodes whose operand is an immediate (LOADI,
; ADDI, SETC, SHL, SHR, JMP) still have mval computed for them, reading a cell
; that means nothing to them. This is harmless — every address wraps into range,
; so the read can never fault — and those handlers simply ignore it.
;
; DISPATCH is an indexed jump through JMPX. A three-level BR3 tree reaches 27
; destinations in 3 branches where binary needs 5, which is the prettier answer,
; but measured it cost 149 cells against 30. BR3 still does the work that suits
; it: in h_br3 the emulated three-way branch is the host's three-way branch.

IBASE:  .equ  200          ; rewritten per level; inner address a is at outer IBASE + a

; ---------------------------------------------------------------- fetch/decode
fetch:  LOAD  ipc
        ADDI  IBASE
        STORE ptr
        LOADX ptr
        STORE opc          ; opcode
        LOAD  ptr
        ADDI  1
        STORE ptr
        LOADX ptr
        STORE opd          ; operand
        ADDI  IBASE
        STORE ea           ; effective address, if the operand is an address
        LOADX ea
        STORE mval         ; and the value living there
        LOAD  ipc
        ADDI  2
        STORE ipc          ; the inner PC advances before the handler runs,
                           ; so jumps may overwrite it freely
        LOAD  opc
        ADDI  jtbl
        STORE ptr          ; ptr = address of the table entry
        LOADX ptr
        STORE ptr          ; ptr = the handler address held in that entry
        JMPX  ptr

; ---------------------------------------------------------------- handlers
h_halt: HALT

h_loadi:LOAD  opd
        STORE ia
        JMP   fetch

h_load: LOAD  mval
        STORE ia
        JMP   fetch

h_store:LOAD  ia
        STOREX ea
        JMP   fetch

h_add:  LOAD  ia
        ADD   mval
        STORE ia
        JMP   fetch

h_addi: LOAD  ia
        ADD   opd
        STORE ia
        JMP   fetch

h_sub:  LOAD  ia
        SUB   mval
        STORE ia
        JMP   fetch

h_neg:  LOAD  ia
        NEG
        STORE ia
        JMP   fetch

h_min:  LOAD  ia
        MIN   mval
        STORE ia
        JMP   fetch

h_max:  LOAD  ia
        MAX   mval
        STORE ia
        JMP   fetch

h_csum: LOAD  ia
        CSUM  mval
        STORE ia
        JMP   fetch

h_setc: LOAD  opd
        STORE ic
        JMP   fetch

h_tgate:LDC   ic           ; the inner control register drives the outer gate
        LOAD  ia
        TGATE mval
        STORE ia
        JMP   fetch

; SHL/SHR take an immediate count, so a variable count repeats a shift of one.
h_shl:  LOAD  opd
        STORE cnt
        LOAD  ia
        STORE tmp
shl_lp: LOAD  cnt
        BR3   shl_t
shl_t:  .table shl_end, shl_end, shl_go
shl_go: LOAD  tmp
        SHL   1
        STORE tmp
        LOAD  cnt
        ADDI  -1
        STORE cnt
        JMP   shl_lp
shl_end:LOAD  tmp
        STORE ia
        JMP   fetch

h_shr:  LOAD  opd
        STORE cnt
        LOAD  ia
        STORE tmp
shr_lp: LOAD  cnt
        BR3   shr_t
shr_t:  .table shr_end, shr_end, shr_go
shr_go: LOAD  tmp
        SHR   1
        STORE tmp
        LOAD  cnt
        ADDI  -1
        STORE cnt
        JMP   shr_lp
shr_end:LOAD  tmp
        STORE ia
        JMP   fetch

h_jmp:  LOAD  opd
        STORE ipc
        JMP   fetch

; The emulated three-way branch, implemented by the host's three-way branch.
h_br3:  LOAD  ia
        BR3   br_t
br_t:   .table br_n, br_z, br_p
br_n:   LOAD  ea
        ADDI  -1
        JMP   br_go
br_z:   LOAD  ea
        JMP   br_go
br_p:   LOAD  ea
        ADDI  1
br_go:  STORE ptr
        LOADX ptr
        STORE ipc
        JMP   fetch

h_out:  LOAD  ia
        OUT
        JMP   fetch

h_in:   IN
        STORE ia
        JMP   fetch

; The emulated machine gets the indirect opcodes too, so it is a complete tryte
; VM rather than a cut-down one — which is what lets it host another of itself.
h_loadx:LOAD  mval
        ADDI  IBASE
        STORE ptr
        LOADX ptr
        STORE ia
        JMP   fetch

h_stox: LOAD  mval
        ADDI  IBASE
        STORE ptr
        LOAD  ia
        STOREX ptr
        JMP   fetch

h_jmpx: LOAD  mval
        STORE ipc
        JMP   fetch

h_ldc:  LOAD  mval
        STORE ic
        JMP   fetch

; ---------------------------------------------------------------- dispatch table
; One entry per opcode, in opcode order. JMPX indexes straight into it.
jtbl:   .word h_halt, h_loadi, h_load, h_store, h_add, h_addi, h_sub, h_neg
        .word h_min, h_max, h_csum, h_setc, h_tgate, h_shl, h_shr, h_jmp
        .word h_br3, h_out, h_in, h_loadx, h_stox, h_jmpx, h_ldc

; ---------------------------------------------------------------- state
ipc:    .word 0            ; inner program counter
ia:     .word 0            ; inner accumulator
ic:     .word 0            ; inner gate-control register
opc:    .word 0            ; opcode being executed
opd:    .word 0            ; its operand
ea:     .word 0            ; operand read as an address
mval:   .word 0            ; the value at that address
ptr:    .word 0            ; scratch pointer for indirect access
tmp:    .word 0
cnt:    .word 0
