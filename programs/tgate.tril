// tgate.tril — Reconfigurable ternary gate modes in high-level Tril
fn main() {
  let x = in();
  let y = in();

  // Mode 1: MIN on all slices
  out(tgate(x, y, t000000));

  // Mode 2: MAX on all slices
  out(tgate(x, y, t++++++));

  // Mode 3: NEG on all slices
  out(tgate(x, y, t------));

  // Mode 4: Mixed slices (+, 0, -, +, 0, -)
  out(tgate(x, y, t+0-+0-));

  halt();
}
